# Development Dockerfile for ERP Log Service
FROM python:3.11-slim

# Install system dependencies including Docker CLI, Node.js and curl for health checks
RUN apt-get update && apt-get install -y \
    curl \
    docker.io \
    nginx \
    sudo \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user and add to docker group
RUN groupadd -g 1001 appgroup && \
    useradd -u 1001 -g appgroup -G docker -m -s /bin/bash appuser

# Set working directory
WORKDIR /app

# Copy and install Python dependencies first (for better caching)
COPY backend/requirements.txt ./backend/
RUN pip install --no-cache-dir -r backend/requirements.txt

# Copy and install Node.js dependencies (for better caching)
COPY frontend/package*.json ./frontend/
RUN cd frontend && npm ci --only=production

# Copy backend application code
COPY --chown=appuser:appgroup backend/ ./backend/

# Copy frontend source code
COPY --chown=appuser:appgroup frontend/ ./frontend/

# Create nginx configuration for serving frontend and proxying API
RUN echo 'server { \
    listen 8092; \
    server_name localhost; \
    \
    # Serve frontend static files \
    location / { \
        root /app/frontend/build; \
        try_files $uri $uri/ /index.html; \
    } \
    \
    # Proxy API requests to backend \
    location /api/ { \
        proxy_pass http://127.0.0.1:8093/api/; \
        proxy_http_version 1.1; \
        proxy_set_header Upgrade $http_upgrade; \
        proxy_set_header Connection "upgrade"; \
        proxy_set_header Host $host; \
        proxy_set_header X-Real-IP $remote_addr; \
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; \
        proxy_set_header X-Forwarded-Proto $scheme; \
    } \
    \
    # WebSocket proxy \
    location /api/v1/logs/ws/ { \
        proxy_pass http://127.0.0.1:8093/api/v1/logs/ws/; \
        proxy_http_version 1.1; \
        proxy_set_header Upgrade $http_upgrade; \
        proxy_set_header Connection "upgrade"; \
        proxy_set_header Host $host; \
        proxy_cache_bypass $http_upgrade; \
    } \
}' > /etc/nginx/sites-available/default

# Copy and set up startup script
COPY start.sh /app/start.sh
RUN chmod +x /app/start.sh

# Create necessary directories and set permissions
RUN mkdir -p /app/logs /app/tmp && \
    chown -R appuser:appgroup /app && \
    chmod 755 /app/tmp

# Expose ports for the services
EXPOSE 8092 8093 3004

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8092/ || exit 1

# Set environment variables
ENV PYTHONPATH=/app/backend
ENV PYTHONUNBUFFERED=1

# Run as root to access Docker socket
USER root

# Start the combined service
CMD ["/app/start.sh"]
