# Development Dockerfile for Log Service (Go) - Single stage for faster builds with hot reload
FROM golang:1.23-alpine

# Install runtime dependencies
RUN apk add --no-cache git ca-certificates tzdata curl

# Create app user (matching docker-compose user: "1001:1001")
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

# Set working directory
WORKDIR /app

# Create cache directories and change ownership
RUN mkdir -p /go/pkg/mod/cache /go/cache && \
    chown -R appuser:appgroup /go /app

# Switch to non-root user
USER appuser

# Install Air for hot reload as appuser
RUN go install github.com/cosmtrek/air@v1.49.0

# Set Go environment variables for proper cache handling
ENV GOCACHE=/go/cache
ENV GOMODCACHE=/go/pkg/mod

# Copy go mod files
COPY --chown=appuser:appgroup go.mod go.sum ./

# Download dependencies
RUN go mod download

# Expose ports
EXPOSE 8001 50052

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# Development command with Air for hot reload
CMD ["/go/bin/air", "-c", ".air.toml"]
