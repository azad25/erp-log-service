# Development Dockerfile for ERP Log Service# Use Python 3.11 slim image
FROM python:3.11-slim

# Install system dependencies including Docker CLI and curl for health checks
RUN apt-get update && apt-get install -y \
    curl \
    docker.io \
    nginx \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user and add to docker group
RUN groupadd -g 1001 appgroup && \
    useradd -u 1001 -g appgroup -G docker -m -s /bin/bash appuser

# Set working directory
WORKDIR /app

# Copy requirements and install Python dependencies
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend application code
COPY --chown=appuser:appgroup backend/ ./backend/

# Copy frontend build
COPY --chown=appuser:appgroup frontend/build/ ./frontend/build/

# Create nginx configuration for serving frontend and proxying API
RUN echo 'server { \
    listen 8092; \
    server_name localhost; \
    \
    # Serve frontend static files \
    location / { \
        root /app/frontend/build; \
        try_files $uri $uri/ /index.html; \
    } \
    \
    # Proxy API requests to backend \
    location /api/ { \
        proxy_pass http://127.0.0.1:8093/api/; \
        proxy_http_version 1.1; \
        proxy_set_header Upgrade $http_upgrade; \
        proxy_set_header Connection "upgrade"; \
        proxy_set_header Host $host; \
        proxy_set_header X-Real-IP $remote_addr; \
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; \
        proxy_set_header X-Forwarded-Proto $scheme; \
    } \
    \
    # WebSocket proxy \
    location /api/v1/logs/ws/ { \
        proxy_pass http://127.0.0.1:8093/api/v1/logs/ws/; \
        proxy_http_version 1.1; \
        proxy_set_header Upgrade $http_upgrade; \
        proxy_set_header Connection "upgrade"; \
        proxy_set_header Host $host; \
        proxy_cache_bypass $http_upgrade; \
    } \
}' > /etc/nginx/sites-available/default

# Create startup script that runs as root to fix Docker socket permissions
RUN echo '#!/bin/bash \
set -e \
\
# Fix Docker socket permissions \
if [ -S /var/run/docker.sock ]; then \
    chmod 666 /var/run/docker.sock \
fi \
\
# Start nginx in background \
nginx -g "daemon off;" & \
\
# Start FastAPI backend on port 8093 \
cd /app && python backend/main.py --host 0.0.0.0 --port 8093 & \
\
# Wait for any process to exit \
wait -n \
\
# Exit with status of process that exited first \
exit $?' > /app/start.sh && chmod +x /app/start.sh

# Create necessary directories and set permissions
RUN mkdir -p /app/logs && \
    chown -R appuser:appgroup /app

# Expose port 8092 for the combined service
EXPOSE 8092

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8092/ || exit 1

# Set environment variables
ENV PYTHONPATH=/app/backend
ENV PYTHONUNBUFFERED=1

# Run as root to access Docker socket
USER root

# Start the combined service
CMD ["/app/start.sh"]
