# Development Dockerfile for Log Service (Go) - Single stage for faster builds with hot reload
FROM golang:1.23-alpine

# Install runtime dependencies
RUN apk add --no-cache git ca-certificates tzdata curl

# Create app user (matching docker-compose user: "1001:1001")
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

# Set working directory
WORKDIR /app

# Install Air for hot reload as root and copy to accessible location
RUN go install github.com/cosmtrek/air@v1.49.0 && \
    cp /go/bin/air /usr/local/bin/air && \
    chmod +x /usr/local/bin/air

# Create cache directories and ensure proper permissions
RUN mkdir -p /go/pkg/mod/cache /go/cache /home/appuser/.cache && \
    chown -R appuser:appgroup /go /app /home/appuser

# Switch to non-root user
USER appuser

# Ensure PATH includes Go bin directory
ENV PATH="/go/bin:/usr/local/bin:${PATH}"

# Set Go environment variables for proper cache handling
ENV GOCACHE=/go/cache
ENV GOMODCACHE=/go/pkg/mod

# Copy go mod files
COPY --chown=appuser:appgroup go.mod go.sum ./

# Download dependencies
RUN go mod download

# Expose ports
EXPOSE 8001 50052

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# Development command with Air for hot reload
CMD ["air", "-c", ".air.toml"]
